{
  "name": "@ijime/crypto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run --coverage.enabled --coverage.include=src/**",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@google-cloud/kms": "^5.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.0"
  }
}

{
  "name": "@ijime/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API（危機の事前検知と SSE を含む）",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "firebase --config firebase.json emulators:exec --only firestore --project demo-ijime \"vitest run\"",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.2.0",
    "@google-cloud/kms": "^5.3.0",
    "@google-cloud/storage": "^7.22.0",
    "@ijime/agent-core": "workspace:*",
    "@ijime/api-types": "workspace:*",
    "@ijime/config": "workspace:*",
    "@ijime/crisis-detector": "workspace:*",
    "@ijime/crypto": "workspace:*",
    "@ijime/kb-loader": "workspace:*",
    "@ijime/service-kit": "workspace:*",
    "google-auth-library": "^10.9.1",
    "hono": "^4.10.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@ijime/calendar-sync": "workspace:*",
    "@ijime/pet-agent": "workspace:*",
    "@ijime/signal-worker": "workspace:*",
    "firebase-tools": "^15.32.0"
  },
  "exports": {
    "./src/*": "./src/*"
  }
}

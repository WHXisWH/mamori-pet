{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "NEXT_DIST_DIR"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/local-*/**"]
    },
    "build:local": {
      "dependsOn": ["^build", "build"],
      "env": ["LOCAL_PORT_OFFSET", "NEXT_DIST_DIR"],
      "outputs": [".next/local-*/**", "!.next/local-*/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "PW_CHROMIUM_PATH",
    "PLAYWRIGHT_BROWSERS_PATH",
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD",
    "NEXT_TELEMETRY_DISABLED",
    "CI",
    "JAVA_TOOL_OPTIONS",
    "JAVA_HOME",
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "NO_PROXY",
    "SSL_CERT_FILE",
    "NODE_EXTRA_CA_CERTS"
  ],
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": ["kb/**"],
  "agentGuidance": false
}
